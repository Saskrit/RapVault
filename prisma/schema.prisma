generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String?
  googleId          String?   @unique
  name              String?
  displayName       String?
  username          String?   @unique
  bio               String    @default("")
  avatarUrl         String?
  coverUrl          String?
  profilePublic     Boolean   @default(true)
  youtubeUrl        String    @default("")
  facebookUrl       String    @default("")
  instagramUrl      String    @default("")
  spotifyUrl        String    @default("")
  appleMusicUrl     String    @default("")
  recoveryEmail     String?   @unique
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  notificationsSeenAt DateTime?
  createdAt         DateTime  @default(now())
  folders           Folder[]
  songs             Song[]
  songViews         SongView[]
  songReactions     SongReaction[]
  songCollaborations SongCollaborator[]
  conversations     ConversationParticipant[]
  messages          Message[]
  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionAddressee")
}

model Connection {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@index([status])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs     Song[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Song {
  id            String    @id @default(cuid())
  title         String    @default("Untitled")
  content       String    @default("")
  genre         String    @default("")
  moodTags      String    @default("")
  status        String    @default("draft")
  isFavorite    Boolean   @default(false)
  isPublic      Boolean   @default(false)
  viewCount     Int       @default(0)
  beatUrl       String    @default("")
  voiceMemoPath String    @default("")
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  views         SongView[]
  reactions     SongReaction[]
  collaborators SongCollaborator[]

  @@index([userId])
  @@index([folderId])
  @@index([userId, deletedAt])
  @@index([isPublic, deletedAt])
}

model SongCollaborator {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([songId, userId])
  @@index([userId])
}

model SongView {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([songId, userId])
  @@index([userId])
}

model SongReaction {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("fire")
  createdAt DateTime @default(now())

  @@unique([songId, userId])
  @@index([userId])
}

model Conversation {
  id           String                     @id @default(cuid())
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@unique([userId, conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}
